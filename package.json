{
  "name": "ps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "package": "vite build && electron-packager . --platform=win32 --arch=x64 --out=dist-desktop --overwrite --icon=logo.ico --ignore=\"^(/(src|Old_sms|public|\\..*|.*\\.py|.*\\.md|.*\\.txt))\"",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.perumalstores.ps",
    "productName": "PS Billing System",
    "directories": {
      "output": "dist-installer"
    },
    "win": {
      "target": "nsis",
      "icon": "logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PS Billing System",
      "artifactName": "PS Billing System Setup Father Edition.exe"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  }
}
